{
  "name": "@avoroglobal/icons",
  "version": "0.1.0",
  "description": "Avoro UI icon set — Lucide-style, stroke-based, registry-governed",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CLAUDE.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AvoroGlobal/avoro-icons.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepare": "npm run build",
    "prepack": "npm test"
  },
  "devDependencies": {
    "@types/react": "^19.0.7",
    "react": "^19.0.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "license": "UNLICENSED"
}
